{
  // Cloudflare Workers (Static Assets) で Vite ビルド成果物を配信する設定。
  // Workers Builds がこのファイルを読み、dist/ を SPA として配信する。
  "name": "rentalist",
  "compatibility_date": "2025-05-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  // ステージング（staging API 向け）。`npm run deploy:staging` で手動デプロイする。
  // 本番の Workers Builds（`wrangler deploy`）はトップレベル設定のみを使うので影響しない。
  "env": {
    "staging": {
      "name": "rentalist-staging",
      "assets": {
        "directory": "./dist",
        "not_found_handling": "single-page-application"
      }
    }
  }
}
